# Copy to .env (never commit .env).

# NASA Earthdata login, for python -m app.cli fetch-imerg / inspect-granule
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Google AI Studio key, for the optional Gemini rewrite in /api/ai/interpret
GEMINI_API_KEY=
GEMINI_MODEL=

# Backend
# MBOASCOPE_DB=data/processed/mboascope.db
# CORS_ORIGINS=http://localhost:5173
